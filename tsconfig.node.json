{
  // Node side: the terminal training (scripts) and the dev server config
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["scripts", "vite.config.ts"]
}
